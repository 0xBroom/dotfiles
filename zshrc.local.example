# Plantilla de ~/.zshrc.local — copiala a $HOME y adaptala por maquina.
#
#   cp zshrc.local.example ~/.zshrc.local
#
# Este archivo vive en la RAIZ del repo, fuera de todo paquete de stow, a
# proposito: asi stow nunca lo symlinkea. Es el escape hatch para todo
# lo que no es portable. Guarda cada bloque detras de un guard de existencia
# para que el mismo archivo sea inofensivo si la herramienta no esta.

# --- Node (nvm) -----------------------------------------------------------
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Google Cloud SDK ----------------------------------------------------
# [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ] && . "$HOME/google-cloud-sdk/path.zsh.inc"
# [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ] && . "$HOME/google-cloud-sdk/completion.zsh.inc"

# --- Herramientas locales en PATH ----------------------------------------
# export PATH="$HOME/.opencode/bin:$PATH"

